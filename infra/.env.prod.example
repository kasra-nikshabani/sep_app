# الگوی Production (Phase 20، ADR-0022) -- کپی به .env.prod در همین پوشه (در .gitignore
# ریشه‌ی پروژه نادیده گرفته می‌شود، دقیقاً مثل .env). استفاده:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# این فایل مستقل از infra/.env (Dev) است -- روی یک VPS واقعی این‌جا هیچ .env دیگری وجود
# ندارد، پس همه‌ی مقادیر پایه (Postgres/Redis/Keycloak/Grafana) هم این‌جا تکرار شده‌اند.
# راهنمای کامل قدم‌به‌قدم (DNS، صدور اولین گواهی TLS، تولید رازها) در docs/deployment.md.

# ---- PostgreSQL ----
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
BACKEND_DB_PASSWORD=

# ---- Redis ----
REDIS_PASSWORD=

# ---- Keycloak ----
# طبق مستندات رسمی Keycloak 26، این دو هم برای Bootstrap اولین کاربر Admin و هم (با نام
# جدید KC_BOOTSTRAP_ADMIN_*, خودکار در docker-compose.prod.yml) استفاده می‌شوند.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=
# فقط Loopback -- تنها راه رسیدن یک Client بیرونی به Keycloak، Caddy است (ADR-0022).
# دلیل این‌که این‌جا (نه یک Override در docker-compose.prod.yml) تنظیم می‌شود:
# docker-compose.yml را ببینید.
KEYCLOAK_BIND_ADDRESS=127.0.0.1

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_BIND_ADDRESS=127.0.0.1

# ---- Loyalty <-> Django polling (ADR-0014) ----
# ticket.sepahansc/football_tickets خارج از این Compose است (طبق مرز مستندشده‌ی همان ADR)؛
# فقط آدرس واقعی و Token مشترک آن را این‌جا بدهید.
LOYALTY_DJANGO_SERVICE_TOKEN=
INFRA_DJANGO_BASE_URL=https://django.example.com

# ---- دامنه‌های عمومی واقعی (پیش‌نیاز: هر چهارتا باید به IP همین سرور Point شده باشند) ----
PUBLIC_DOMAIN_BACKEND=api.example.com
PUBLIC_DOMAIN_ADMIN=admin.example.com
PUBLIC_DOMAIN_KEYCLOAK=auth.example.com
PUBLIC_DOMAIN_GRAFANA=grafana.example.com

# ایمیل واقعی -- Let's Encrypt فقط برای اطلاع‌رسانی انقضا/مشکل گواهی از آن استفاده می‌کند.
CADDY_ACME_EMAIL=

# ---- Admin Panel (ADR-0016/ADR-0022) ----
# از Keycloak Admin Console -> Clients -> admin-panel -> Credentials (بعد از اولین Import Realm)
ADMIN_PANEL_KEYCLOAK_CLIENT_SECRET=
# با: openssl rand -base64 32
ADMIN_PANEL_AUTH_SECRET=

# ---- اختیاری: فقط اگر نسخه‌ی Web اپ موبایل هم Public میزبانی شود (خارج از دامنه‌ی این فاز) ----
# CORS_ALLOWED_ORIGINS=https://mobile-web.example.com

# ---- اختیاری: جایگزینی Providerهای fake با نسخه‌ی واقعی (هم‌نام با infra/.env.example) ----
# SMS_IR_API_KEY=
# SMS_IR_LINE_NUMBER=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=
# FCM_SERVICE_ACCOUNT_PATH=
