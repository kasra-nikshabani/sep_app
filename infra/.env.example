# این فایل نمونه است و امن است که در Git بماند — مقادیر واقعی را در یک فایل .env
# (کنار همین فایل، در infra/) کپی کنید؛ .env در .gitignore ریشه‌ی پروژه نادیده گرفته می‌شود.
# هرگز مقادیر واقعی را در این فایل (.env.example) یا هر Commit دیگری قرار ندهید.

# نکته: پورت‌های پیش‌فرض ۵۴۳۲/۶۳۷۹ عمداً استفاده نشدند — روی این ماشین یک PostgreSQL/Redis
# محلی (سیستمی، خارج از Docker) از قبل روی همان پورت‌ها در حال اجراست (احتمالاً برای
# ticket.sepahansc). این‌جا پورت‌های جایگزین گرفته شده تا با آن سرویس‌ها تداخل نکند.

# ---- PostgreSQL ----
POSTGRES_PORT=5433
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme-local-only

# ---- Redis ----
REDIS_PORT=6380
REDIS_PASSWORD=changeme-local-only

# ---- Keycloak (فقط برای اجرای Dev Mode؛ تنظیمات Realm در Phase 4) ----
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-local-only
# اتصال Keycloak به همان Postgres، دیتابیس مجزای «keycloak» (طبق infra/postgres/init/01-databases.sql)
KEYCLOAK_DB_USERNAME=postgres
KEYCLOAK_DB_PASSWORD=changeme-local-only

# ---- Backend (Spring Boot) — Phase 6 ----
# رمز نقش اختصاصی Postgres که فقط مالک دیتابیس sepahan_app است (نه Superuser، نه دسترسی به دیتابیس keycloak)
# طبق infra/postgres/init/02-create-app-role.sh
BACKEND_DB_PASSWORD=changeme-local-only

# ---- Loyalty <-> Django polling (Phase 12، ADR-0014) ----
# راز مشترک بین این Backend و ticket.sepahansc/football_tickets (Endpoint فقط-خواندنی
# tickets/api/loyalty/completed-orders/). باید دقیقاً همین مقدار در .env سمت Django هم
# باشد (متغیر LOYALTY_POLL_SERVICE_TOKEN آن‌جا). با «openssl rand -hex 32» تولید شود.
LOYALTY_DJANGO_SERVICE_TOKEN=changeme-local-only

# ---- Observability: Prometheus/Loki/Promtail/Grafana (Phase 17، ADR-0019) ----
# Prometheus (۹۰۹۰) و Loki (۳۱۰۰) با پورت پیش‌فرض ماندند -- بدون تداخل شناخته‌شده. Grafana
# پیش‌فرضش عمداً ۳۰۳۰ است نه ۳۰۰۰ -- Admin Panel (Phase 14) دقیقاً همان پورت را می‌خواهد.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-local-only
