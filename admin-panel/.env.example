# مقدار واقعی در .env.local (هرگز Commit نمی‌شود). این فایل فقط الگو است.

# از Keycloak Admin Console -> Clients -> admin-panel -> Credentials
KEYCLOAK_CLIENT_ID=admin-panel
KEYCLOAK_CLIENT_SECRET=

KEYCLOAK_ISSUER=http://localhost:8080/realms/sepahan

# Secret رمزنگاری Session خود Auth.js -- با `openssl rand -base64 32` بساز
AUTH_SECRET=

AUTH_URL=http://localhost:3000

# آدرس Backend اصلی (Spring Boot) -- فقط از سمت سرور Next.js فراخوانی می‌شود
BACKEND_API_BASE_URL=http://localhost:8081
