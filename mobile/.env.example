# مقادیر واقعی در .env.local (این‌ها Public هستند -- طبق قرارداد EXPO_PUBLIC_
# در باندل نهایی اپ Inline می‌شوند؛ هیچ‌کدام راز نیستند -- mobile-app یک
# Keycloak Public Client بدون Secret است).

EXPO_PUBLIC_API_BASE_URL=http://localhost:8081
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8080/realms/sepahan
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=mobile-app

# آدرسی که کاشی «بلیط مسابقات» در مرورگر داخل اپ باز می‌کند (سایت بلیط فوتبال).
# تا وقتی «ورود با Fan ID» روی سایت روشن نشده: https://ticket.sepahansc.com/matches/
# بعد از روشن شدن (ورود بدون فرم و بدون ثبت‌نام دوباره):
#   https://ticket.sepahansc.com/accounts/fanid/login/?next=/matches/
EXPO_PUBLIC_TICKET_SITE_URL=http://localhost:8000/accounts/fanid/login/?next=/matches/

# پخش زنده‌ی سپاهان TV. همان آدرسی که سایت باشگاه به آن لینک می‌دهد.
EXPO_PUBLIC_SEPAHAN_TV_URL=https://livekadeh.com/sepahantv/

# مدارس ورزشی سپاهان.
EXPO_PUBLIC_ACADEMY_URL=https://academy.sepahansc.com/
