# مقادیر واقعی در .env.local (این‌ها Public هستند -- طبق قرارداد EXPO_PUBLIC_
# در باندل نهایی اپ Inline می‌شوند؛ هیچ‌کدام راز نیستند -- mobile-app یک
# Keycloak Public Client بدون Secret است).

EXPO_PUBLIC_API_BASE_URL=http://localhost:8081
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8080/realms/sepahan
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=mobile-app
