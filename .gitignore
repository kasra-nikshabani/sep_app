# Secrets / environment
.env
.env.*
!.env.example
!.env.prod.example
*.pem
*.key

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Java / Spring Boot (Phase 2+)
backend/target/
backend/build/
backend/.gradle/
backend/HELP.md
*.class
*.jar
!backend/.mvn/wrapper/maven-wrapper.jar

# Local runtime data (Phase 11+) -- رسانه‌ی آپلودشده روی دیسک محلی، طبق ADR-0013
backend/data/

# Node / Next.js (Phase 2+)
node_modules/
admin-panel/.next/
admin-panel/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# React Native (Phase 2+)
mobile/node_modules/
mobile/ios/Pods/
mobile/ios/build/
mobile/android/.gradle/
mobile/android/app/build/
*.keystore
!debug.keystore

# Logs / coverage
*.log
coverage/

# Structured logs written at runtime (Phase 17/18، ADR-0019/0020) -- شامل فایل‌های Rotate/
# Gzip‌شده‌ی Logback که با *.log ساده گرفته نمی‌شوند؛ backend/logs/ باید در Checkout خالی
# وجود داشته باشد (Mount شده توسط Promtail) پس فقط محتوا نادیده گرفته می‌شود، نه خودِ پوشه.
backend/logs/*
!backend/logs/.gitkeep

# Infra local state (Phase 3+)
infra/**/*.local.yml
